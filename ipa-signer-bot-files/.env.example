# Telegram Bot Token from @BotFather
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Admin Telegram user IDs (comma separated, e.g. 12345678,87654321)
ADMIN_IDS=12345678

# Admin Telegram Username (without @) for VIP customer inquiries
ADMIN_USERNAME=YourTelegramHandle

# Maximum file size for direct Telegram uploads in MB (default 50)
MAX_FILE_SIZE_MB=50

# VIP Subscription Pricing
VIP_PRICE_1_MONTH=$5
VIP_PRICE_LIFETIME=$20

# Optional: Path to custom zsign binary (defaults to 'zsign' in PATH)
ZSIGN_PATH=zsign

# Optional: Base URL for web server if generating direct OTA install links
OTA_BASE_URL=
